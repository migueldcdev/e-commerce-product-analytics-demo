# Copy to .env.local. Every VITE_ var is baked into the client bundle and is PUBLIC.
# Only the PostHog project key (public by design) and host belong here.
# Never put the PostHog personal API key in a VITE_ var.
VITE_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
